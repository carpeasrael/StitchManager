# markdownlint-cli2 ist eine reine Befehlszeilenanwendung ohne Bauschritt.
# Installationsskripte Dritter sind dafür nicht erforderlich (SM-OSS-011).
#
# Ohne diese Zeile führte `npm` die preinstall-, install- und
# postinstall-Skripte **jedes** Pakets der Kette mit den Rechten der Nutzerin
# aus — auf demselben Rechner, der den Schlüsselspeicher des Betriebssystems,
# die SSH-Zugänge und dieses Repository trägt. Die Integritätshashes im
# Lockfile schützen davor nicht: Sie sichern den Inhalt der gepinnten Fassung,
# nicht die Absicht ihres Herausgebers.
ignore-scripts=true
